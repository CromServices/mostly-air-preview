{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "1180px",
      "wideSize": "1180px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "cyan", "color": "#05ABE0", "name": "Brand cyan" },
        { "slug": "cyan-mid", "color": "#53CBF1", "name": "Cyan mid" },
        { "slug": "cyan-light", "color": "#87E0FD", "name": "Cyan light" },
        { "slug": "navy", "color": "#07364B", "name": "Navy" },
        { "slug": "navy-mid", "color": "#0E6992", "name": "Navy mid" },
        { "slug": "navy-deep", "color": "#10556E", "name": "Navy deep" },
        { "slug": "ink", "color": "#13242D", "name": "Ink" },
        { "slug": "ice", "color": "#F4F8FB", "name": "Page ice" },
        { "slug": "paper", "color": "#FFFFFF", "name": "Paper" },
        { "slug": "muted", "color": "#4A6570", "name": "Muted" },
        { "slug": "line", "color": "#C9DCE4", "name": "Line" },
        { "slug": "gap", "color": "#E9F1F6", "name": "Gap" }
      ],
      "gradients": [
        {
          "slug": "brand-header",
          "name": "Brand header",
          "gradient": "linear-gradient(180deg, #05ABE0 0%, #53CBF1 66%, #87E0FD 100%)"
        }
      ]
    },
    "typography": {
      "fluid": false,
      "fontFamilies": [
        {
          "fontFamily": "Outfit, \"Segoe UI\", sans-serif",
          "name": "Outfit",
          "slug": "outfit",
          "fontFace": [
            {
              "fontFamily": "Outfit",
              "fontWeight": "400",
              "fontStyle": "normal",
              "src": ["file:./assets/fonts/outfit-400.woff2"]
            },
            {
              "fontFamily": "Outfit",
              "fontWeight": "700",
              "fontStyle": "normal",
              "src": ["file:./assets/fonts/outfit-700.woff2"]
            }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "small", "size": "13px", "name": "Small" },
        { "slug": "medium", "size": "16px", "name": "Medium" },
        { "slug": "large", "size": "20px", "name": "Large" },
        { "slug": "x-large", "size": "28px", "name": "Extra large" },
        { "slug": "xx-large", "size": "36px", "name": "Heading" },
        { "slug": "xxx-large", "size": "48px", "name": "Display" }
      ]
    },
    "spacing": {
      "units": ["px", "rem"],
      "spacingSizes": [
        { "slug": "20", "size": "16px", "name": "20" },
        { "slug": "30", "size": "24px", "name": "30" },
        { "slug": "40", "size": "48px", "name": "40" },
        { "slug": "50", "size": "56px", "name": "50" },
        { "slug": "60", "size": "72px", "name": "60" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--ice)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--outfit)",
      "fontSize": "18px",
      "lineHeight": "1.5"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontWeight": "700",
          "letterSpacing": "-0.03em"
        },
        "color": {
          "text": "var(--wp--preset--color--navy)"
        }
      },
      "link": {
        "color": {
          "text": "inherit"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--cyan)",
          "text": "var(--wp--preset--color--paper)"
        },
        "border": {
          "radius": "4px"
        },
        "typography": {
          "fontWeight": "700",
          "fontSize": "16px"
        }
      }
    }
  }
}
